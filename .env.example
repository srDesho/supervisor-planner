# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo a .env y reemplaza los valores de ejemplo.
# NUNCA subas el .env real al repositorio.
# ==========================================

# ==========================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==========================================
APP_ENV=development
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ==========================================
# ZONA HORARIA Y REGLAS OPERATIVAS
# ==========================================
TIMEZONE=America/La_Paz

# Cada cuántos minutos corre el ciclo de recordatorios (debe dividir 60).
REMINDER_INTERVAL_MINUTES=30
# Mínimo entre dos recordatorios al mismo supervisor.
# 1 para pruebas; producción: 60
REMINDER_COOLDOWN_MINUTES=1
# No se envía recordatorio a quien escribió al bot en los últimos N minutos.
REMINDER_ACTIVITY_WINDOW_MINUTES=10
# El mismo texto del mismo teléfono en menos de N segundos se ignora (doble envío).
DUPLICATE_MESSAGE_WINDOW_SECONDS=2

# Reintentos de llamadas a Google Sheets que fallan con 429 (cuota) o 5xx.
# Esperas: BASE, 2*BASE, 4*BASE... segundos. Los errores 400/401/403/404 no se reintentan.
SHEETS_MAX_RETRIES=3
SHEETS_RETRY_BASE_DELAY=1

# Schedule de recordatorios por día (America/La_Paz).
# Lunes: ventana AM (recordatorio para HOY) y ventana PM (para MAÑANA).
MONDAY_AM_WINDOW_START=08:00
MONDAY_AM_ESCALATION_TIME=12:00
MONDAY_PM_WINDOW_START=15:00
MONDAY_PM_ESCALATION_TIME=18:00

# Martes a viernes: solo ventana PM (recordatorio para el día siguiente).
WEEKDAY_PM_WINDOW_START=15:00
WEEKDAY_PM_ESCALATION_TIME=18:00

# Sábado: ventana AM (recordatorio para HOY), sin escalamiento.
# El último recordatorio sale a SATURDAY_AM_LAST_REMINDER aunque no haya
# pasado el cooldown.
SATURDAY_AM_WINDOW_START=08:00
SATURDAY_AM_LAST_REMINDER=11:30

# Estado conversacional (en memoria) y caché de supervisores (en memoria).
CONVERSATION_TTL_MINUTES=30
SUPERVISORS_CACHE_TTL_SECONDS=300

# ==========================================
# GOOGLE SHEETS
# ==========================================
# Ruta al JSON de la Service Account de Google.
# Cómo obtenerlo: Google Cloud Console → IAM & Admin → Service Accounts → Keys
# Guárdalo en credentials/credentials.json (esa carpeta está en .gitignore)
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json

# ID del Google Sheet.
# Está en la URL: https://docs.google.com/spreadsheets/d/<ESTE_ES_EL_ID>/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Nombres exactos de las pestañas del Sheet (respetan mayúsculas/tildes)
GOOGLE_WORKSHEET_SCZ=PLANIFICACION_SCZ_RENOM
GOOGLE_WORKSHEET_LPZ=PLANIFICACION_LPZ
GOOGLE_WORKSHEET_CBBA=PLANIFICACION_CBBA_RENOM
GOOGLE_OUTPUT_WORKSHEET=PLANIFICACION_DIARIA
GOOGLE_WORKSHEET_SUPERVISORS=SUPERVISORES
GOOGLE_WORKSHEET_LOG=LOG_BOT
SHEETS_CACHE_TTL_SECONDS=1800

# ==========================================
# GOOGLE GEMINI API
# ==========================================
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10

# ==========================================
# WAHA (WHATSAPP HTTP API)
# ==========================================
# Dentro de Docker Compose usa el nombre del servicio: http://supervisor-waha:3000
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=tu_waha_api_key_aqui
WAHA_SESSION=default

# Credenciales del dashboard de WAHA (cámbialas en producción)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change_me_in_production
WAHA_DASHBOARD_NO_PASSWORD=True

# ==========================================
# ADMINISTRACIÓN Y ALERTAS
# ==========================================
ADMIN_PHONE=70000000
STATUS_GROUP_ID=120363000000000000@g.us
